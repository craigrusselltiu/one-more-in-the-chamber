# Supabase project credentials (required for auth & cloud sync)
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OAuth providers are configured in the Supabase dashboard:
# Authentication → Providers → Enable Google / GitHub / Discord
# Each provider requires its own client ID/secret from the respective platform.
# Redirect URL for all providers: https://your-project.supabase.co/auth/v1/callback
